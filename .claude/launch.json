{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "isfc-dev",
      "runtimeExecutable": "npm.cmd",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "isfc-dev-trace",
      "runtimeExecutable": "cmd.exe",
      "runtimeArgs": ["/c", "set SQL_TRACE=2&& npm run dev"],
      "port": 3000
    },
    {
      "name": "isfc-dev-3100",
      "runtimeExecutable": "cmd.exe",
      "runtimeArgs": ["/c", "set SQL_TRACE=2&& npm run dev -- -p 3100"],
      "port": 3100
    }
  ]
}
